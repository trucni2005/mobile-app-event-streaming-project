ENV=dev
# IP mà các UI có đăng nhập (Kafka UI, Metabase, MinIO console) bind vào.
# Máy dev: 127.0.0.1. Server: IP của interface VPN. Không bao giờ dùng 0.0.0.0
# (Docker publish port bỏ qua ufw); `make check-exposure` sẽ chặn.
BIND_ADDR=127.0.0.1
PG_HOST=postgres
PG_DATABASE=postgres
PG_SUPERUSER=postgres
# User của simulator (chỉ INSERT). Superuser password nằm ở secrets/pg_superuser_password.
PG_USER=simulator_app
PG_PASSWORD=change-me
PG_DEBEZIUM_USER=debezium
PG_DEBEZIUM_PASSWORD=change-me
# Root credentials của MinIO, cũng là credentials S3 của Spark/Trino/iceberg-rest.
# Secret tối thiểu 8 ký tự; sinh bằng: openssl rand -base64 24
AWS_ACCESS_KEY_ID=minio-admin
AWS_SECRET_ACCESS_KEY=change-me-min-8-chars
S3_ENDPOINT=http://minio:9000
ICEBERG_REST_URI=http://iceberg-rest:8181
AWS_REGION=us-east-1
KAFKA_UI_USER=admin
KAFKA_UI_PASSWORD=change-me
# Password user `admin` của tooling-db (DB Metabase + Iceberg catalog).
# Đổi trên DB đang chạy: sửa ở đây rồi `make tooling-db-roles`.
TOOLING_DB_PASSWORD=change-me
